generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  username        String?       @unique
  emailVerified   Boolean       @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastActive      DateTime      @default(now())
  achievements    Achievement[]
  scores          Score?
  attempts        UserAttempt[]
  profile         UserProfile?

  @@index([email])
  @@index([username])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([createdAt])
}

model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String?
  bio           String?
  avatarUrl     String?
  totalPoints   Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  level         Int      @default(1)
  experience    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuestionTemplate {
  id                String           @id @default(cuid())
  type              QuestionType
  category          QuestionCategory
  title             String
  templateText      String
  formulaTemplate   String
  variables         Json
  units             Json
  hints             String[]
  explanation       String
  conversionFactors Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  attempts          UserAttempt[]

  @@index([type, category])
}

model UserAttempt {
  id              String           @id @default(cuid())
  userId          String
  questionId      String
  generatedValues Json
  userAnswer      Float
  correctAnswer   Float
  isCorrect       Boolean
  tolerance       Float            @default(0.01)
  timeSpent       Int
  hintsUsed       Int              @default(0)
  pointsEarned    Int
  attemptedAt     DateTime         @default(now())
  question        QuestionTemplate @relation(fields: [questionId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt])
  @@index([questionId])
}

model Score {
  id               String   @id @default(cuid())
  userId           String   @unique
  dailyScore       Int      @default(0)
  weeklyScore      Int      @default(0)
  monthlyScore     Int      @default(0)
  allTimeScore     Int      @default(0)
  lastResetDaily   DateTime @default(now())
  lastResetWeekly  DateTime @default(now())
  lastResetMonthly DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dailyScore(sort: Desc)])
  @@index([weeklyScore(sort: Desc)])
  @@index([monthlyScore(sort: Desc)])
  @@index([allTimeScore(sort: Desc)])
}

model Achievement {
  id         String          @id @default(cuid())
  userId     String
  type       AchievementType
  unlockedAt DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model Guide {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  description      String
  content          String
  featuredImage    String?
  difficulty       Difficulty     @default(BEGINNER)
  prerequisites    String[]
  learningOutcomes String[]
  practiceProblems Json?
  order            Int            @default(0)
  categoryId       String
  isPublished      Boolean        @default(false)
  viewCount        Int            @default(0)
  readingTime      Int
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  category         GuideCategory  @relation(fields: [categoryId], references: [id])
  concepts         GuideConcept[] @relation("GuideToGuideConcept")

  @@index([slug])
  @@index([categoryId])
  @@index([difficulty])
  @@index([isPublished])
}

model GuideCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guides      Guide[]

  @@index([slug])
  @@index([order])
}

model GuideConcept {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guides      Guide[]  @relation("GuideToGuideConcept")

  @@index([slug])
}

enum QuestionType {
  DOSAGE_CALCULATION
  IV_DRIP_RATE
  UNIT_CONVERSION
  PEDIATRIC_DOSING
  CONCENTRATION
  DILUTION
  DIMENSIONAL_ANALYSIS
  CRITICAL_CARE
  INSULIN_DOSING
  HEPARIN_PROTOCOL
  RECONSTITUTION
}

enum QuestionCategory {
  ORAL_MEDICATION
  INJECTABLE_MEDICATION
  IV_MEDICATION
  WEIGHT_BASED
  BSA_BASED
  METRIC_CONVERSION
  TIME_CONVERSION
  VOLUME_CONVERSION
  DIMENSIONAL_ANALYSIS
  SLIDING_SCALE
  CORRECTION_FACTOR
  HEPARIN_CALCULATION
  POWDER_RECONSTITUTION
  CRITICAL_CALCULATION
}

enum AchievementType {
  FIRST_CORRECT
  STREAK_3
  STREAK_7
  STREAK_30
  ACCURACY_80
  ACCURACY_90
  ACCURACY_100
  SPEED_DEMON
  LEVEL_5
  LEVEL_10
  LEVEL_25
  LEVEL_50
  QUESTIONS_10
  QUESTIONS_50
  QUESTIONS_100
  QUESTIONS_500
  QUESTIONS_1000
  CATEGORY_MASTER
  ALL_CATEGORIES
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}
